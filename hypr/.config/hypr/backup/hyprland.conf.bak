source = /home/bo7afes/.cache/wal/colors-hyprland.conf

################
### MONITORS ###
################

monitor=eDP-1,1366x768@59.97300,auto,1

###################
### MY PROGRAMS ###
###################

$terminal = alacritty
$fileManager = dolphin
$menu = rofi -show drun

#################
### AUTOSTART ###
#################

exec-once = swww-daemon & waybar & swaync & hyprlock
exec-once = ~/.config/waybar/scripts/update_workspace_icons.py
exec-once = ~/.config/waybar/scripts/hyprworkstyle.py
exec-once = hyprctl setcursor capitaine-cursors 24

#############################
### ENVIRONMENT VARIABLES ###
#############################

env = XCURSOR_THEME,capitaine-cursors
env = HYPRCURSOR_THEME,capitaine-cursors
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

#####################
### LOOK AND FEEL ###
#####################

general {
    gaps_in = 2
    gaps_out = 4
    border_size = 3
    col.active_border = rgba($color_activeee)
    col.inactive_border = rgba($color_inactiveaa)
    resize_on_border = true
    extend_border_grab_area = 20
    allow_tearing = false
    layout = dwindle
}

decoration {
    rounding = 10
    rounding_power = 10
    active_opacity = 1.0
    inactive_opacity = 0.8
    shadow {
        enabled = false
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }
    blur {
        enabled = true
        size = 3
        passes = 1
        vibrancy = 0.1696
    }
}

animations {
    enabled = yes, please :)
    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1
    animation = global,        1, 1,   default
    animation = border,        1, 5.39, easeOutQuint
    animation = windows,       1, 4,   easeOutQuint
    animation = windowsIn,     1, 4,   easeOutQuint, slide bottom
    animation = windowsOut,    1, 3,   easeOutQuint, slide bottom
    animation = fadeIn,        1, 1,   almostLinear
    animation = fadeOut,       1, 1,   almostLinear
    animation = fade,          1, 1,   quick
    animation = layers,        1, 1,   easeOutQuint
    animation = layersIn,      1, 1,   easeOutQuint, fade
    animation = layersOut,     1, 1,   linear, fade
    animation = fadeLayersIn,  1, 1,   almostLinear
    animation = fadeLayersOut, 1, 1,   almostLinear
    animation = workspaces,    1, 1,   almostLinear, fade
    animation = workspacesIn,  1, 1,   almostLinear, fade
    animation = workspacesOut, 1, 1,   almostLinear, fade
    animation = zoomFactor,    1, 7,   quick
}

dwindle {
    preserve_split = true
}

master {
    new_status = master
}

misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
}

#############
### INPUT ###
#############

input {
    kb_layout = us,ara
    kb_variant =
    kb_model =
    kb_options = grp:alt_shift_toggle
    kb_rules =
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = true
    }
}

device {
    name = epic-mouse-v1
    sensitivity = -0.5
}

##############################
### WINDOW RULES           ###
##############################





layerrule = blur, wlogout
layerrule = ignorezero, wlogout
layerrule = ignorealpha 0.5, wlogout

###################
### KEYBINDINGS ###
###################

$mainMod = SUPER
$monitor = eDP-1,1366x768@59.97300,0x0,1

bind = $mainMod, return, exec, $terminal
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, space, exec, $menu || pkill rofi
bind = $mainMod, B, exec, brave
bind = $mainMod, F10, exec, obs
bind = SUPER, d, exec, discord
bind = CTRL SHIFT, ESCAPE, exec, alacritty -e btop

bind = $mainMod, C, killactive,
bind = $mainMod, M, exit,
bind = $mainMod, V, togglefloating,
bind = $mainMod, P, pseudo,
bind = $mainMod, J, togglesplit,
bind = $mainMod, K, exec, ~/.local/bin/wvkbd-toggle

bind = $mainMod SHIFT, p, exec, waypaper --folder ~/Pictures/Wallpapers
bind = $mainMod, w, exec, ~/.config/waybar/reload.sh
bind = SUPER, z, exec, pkill -USR1 waybar

bind = $mainMod SHIFT, X, exec, loginctl poweroff
bind = $mainMod SHIFT, R, exec, systemctl reboot
bind = $mainMod SHIFT, L, exec, hyprlock

bind = , Print, exec, grim ~/Pictures/screenshot-$(date +%F-%T).png
bind = SHIFT, Print, exec, grim -g "$(slurp)" ~/Pictures/area-$(date +%F-%T).png
bind = $mainMod SHIFT, s, exec, grim -g "$(slurp)" - | wl-copy --type image/png

bind = CTRL ALT, up,    exec, hyprctl keyword monitor $monitor,transform,0 ; hyprctl keyword device:synps/2-synaptics-touchpad:transform 0
bind = CTRL ALT, right, exec, hyprctl keyword monitor $monitor,transform,1 ; hyprctl keyword device:synps/2-synaptics-touchpad:transform 1
bind = CTRL ALT, down,  exec, hyprctl keyword monitor $monitor,transform,2 ; hyprctl keyword device:synps/2-synaptics-touchpad:transform 2
bind = CTRL ALT, left,  exec, hyprctl keyword monitor $monitor,transform,3 ; hyprctl keyword device:synps/2-synaptics-touchpad:transform 3

bind = $mainMod, h, movefocus, l
bind = $mainMod, l, movefocus, r
bind = $mainMod, k, movefocus, u
bind = $mainMod, j, movefocus, d

bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

bindel = ,XF86AudioRaiseVolume,  exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume,  exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute,         exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute,      exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp,   exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

bindl = , XF86AudioNext,  exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay,  exec, playerctl play-pause
bindl = , XF86AudioPrev,  exec, playerctl previous

bind = SUPER CTRL, right, exec, ~/.config/waybar/scripts/wallpaper-next.sh
bind = SUPER CTRL, left,  exec, ~/.config/waybar/scripts/wallpaper-prev.sh

##############################
### WINDOW RULES           ###
##############################

windowrule = float, class:wlogout
windowrule = center, class:wlogout
windowrule = size 500 500, class:wlogout
windowrule = noborder, class:wlogout
windowrule = float, title:wvkbd
windowrule = nofocus, title:wvkbd
windowrule = center, title:wvkbd
windowrule = float, class:clock-popup
windowrule = pin, class:clock-popup
windowrule = noborder, class:clock-popup
windowrule = nofocus, class:clock-popup
windowrule = size 160 80, class:clock-popup
windowrule = move 100%-180 20, class:clock-popup
windowrule = opacity 0.90, class:clock-popup
